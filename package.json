{
    "name": "nordic-spal-vscode",
    "displayName": "Nordic Spal",
    "description": "My VS Code theme, gold and red, following the Omarchy palette where Omarchy runs",
    "publisher": "spal",
    "version": "1.0.0",
    "license": "UNLICENSED",
    "private": true,
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Themes"
    ],
    "extensionKind": [
        "ui"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Nordic Spal",
                "uiTheme": "vs-dark",
                "path": "./themes/nordic-spal-color-theme.json",
                "_watch": true
            },
            {
                "label": "Nordic Spal Red",
                "uiTheme": "vs-dark",
                "path": "./themes/nordic-spal-red-color-theme.json",
                "_watch": true
            }
        ],
        "commands": [
            {
                "command": "nordicSpal.refresh",
                "title": "Nordic Spal: Reload Omarchy Palette"
            }
        ],
        "configuration": {
            "title": "Nordic Spal",
            "properties": {
                "nordicSpal.followOmarchy": {
                    "type": "boolean",
                    "default": true,
                    "scope": "machine",
                    "description": "On a host running Omarchy, recolour the theme with the active Omarchy palette. Hosts without Omarchy always use the baked Nordic Spal colours."
                }
            }
        }
    }
}
