    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#7B88A1",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Variables and parameters",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.parameter",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#FFFFFF",
                "fontStyle": ""
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier",
                "keyword.other"
            ],
            "settings": {
                "foreground": "#E8956A",
                "fontStyle": ""
            }
        },
        {
            "name": "Imports",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.other.use.php",
                "keyword.other.import"
            ],
            "settings": {
                "foreground": "#BF616A"
            }
        },
        {
            "name": "this, self, super",
            "scope": [
                "variable.language",
                "variable.language.this"
            ],
            "settings": {
                "foreground": "#E8956A"
            }
        },
        {
            "name": "Numbers, booleans, constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.other",
                "constant.character",
                "variable.other.constant",
                "support.constant",
                "variable.other.enummember",
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#BE9DB8"
            }
        },
        {
            "name": "Built-in types",
            "scope": [
                "support.type.primitive",
                "support.type.builtin",
                "keyword.other.type.php",
                "storage.type.primitive",
                "support.type",
                "support.type.primitive.ts",
                "support.type.primitive.tsx",
                "support.type.builtin.ts"
            ],
            "settings": {
                "foreground": "#88C0D0"
            }
        },
        {
            "name": "Built-in functions",
            "scope": [
                "support.function",
                "meta.function-call support.function"
            ],
            "settings": {
                "foreground": "#88C0D0"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key",
                "support.type.property-name",
                "support.variable.property",
                "meta.property-access variable.other.property"
            ],
            "settings": {
                "foreground": "#8FBCBB",
                "fontStyle": ""
            }
        },
        {
            "name": "Operators and brackets",
            "scope": [
                "keyword.operator",
                "meta.brace",
                "punctuation.definition.block",
                "punctuation.section",
                "punctuation.definition.parameters",
                "punctuation.definition.array",
                "punctuation.definition.arguments",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.relational",
                "keyword.operator.increment",
                "keyword.operator.decrement",
                "keyword.operator.bitwise"
            ],
            "settings": {
                "foreground": "#C0C8D8"
            }
        },
        {
            "name": "Delimiters",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor"
            ],
            "settings": {
                "foreground": "#60728A",
                "fontStyle": "italic"
            }
        },
        {
            "name": "HTML tags",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#81A1C1"
            }
        },
        {
            "name": "Tag attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#EBCB8B"
            }
        },
        {
            "name": "Tag delimiters",
            "scope": [
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#C0C8D8"
            }
        },
        {
            "name": "Decorators and attributes",
            "scope": [
                "punctuation.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator variable.other.readwrite",
                "meta.attribute.php"
            ],
            "settings": {
                "foreground": "#BF616A"
            }
        }
    ],
    "semanticTokenColors": {
        "variable": "#FFFFFF",
        "parameter": "#FFFFFF",
        "property": "#8FBCBB",
        "variable.readonly": "#BE9DB8",
        "variable.constant": "#BE9DB8",
        "enumMember": "#BE9DB8",
        "variable.defaultLibrary": "#FFFFFF",
        "function.defaultLibrary": "#88C0D0",
        "type.defaultLibrary": "#88C0D0",
        "namespace": "#EBCB8B",
        "decorator": "#BF616A"
    }
}
